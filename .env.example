# Скопируйте в .env и заполните. Файл .env не попадает в git.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Интервал опроса в секундах (по умолчанию 900 = 15 минут)
INTERVAL_SECONDS=900
# Бесплатный ключ FRED (https://fred.stlouisfed.org/docs/api/api_key.html).
# Необязателен, но с ним данные ФРС грузятся быстрее и без таймаутов.
FRED_API_KEY=
